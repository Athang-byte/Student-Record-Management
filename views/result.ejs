<%- include('./base/header.ejs') %>

    <div class="alert alert-primary w-50 mx-auto" role="alert">
        <h3 class="text-dark text-center">
            Search Query : <%= searchQuery || '' %>
        </h3>
    </div>

    <div class="container">
        <% if (students.length> 0) { %>
            <table class="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>City</th>
                        <th>Contact</th>
                        <th>Edit</th>
                        <th>Delete</th>

                    </tr>
                </thead>
                <tbody>
                    <% students.forEach((student, index)=> { %>
                        <tr>
                            <th scope="row">
                                <%= index + 1 %>
                            </th>
                            <td>
                                <%= student.name %>
                            </td>
                            <td>
                                <%= student.email %>
                            </td>
                            <td>
                                <%= student.city %>
                            </td>
                            <td>
                                <%= student.contact %>
                            </td>
                            <td><a href="/edit/<%= student._id %>">Edit</a></td>
                            <td>
                                <form action="/delete/<%= student._id %>" method="POST">
                                    <input type="submit" value="Delete">
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
            <% } else { %>
                <p class="text-center text-danger">No matching students found.</p>
                <% } %>

                    <a href="/" class="btn btn-secondary mt-3">Back to Search</a>
    </div>

    <%- include('./base/footer.ejs') %>